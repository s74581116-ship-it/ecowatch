rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sharonmanoj456@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidReport(data) {
      return data.keys().hasAll([
        'issueId', 'reporterName', 'phoneNumber', 'category',
        'description', 'imageUrl', 'status', 'severity', 'isEmergency', 'createdAt'
      ]) &&
      data.issueId is string && data.issueId.size() <= 64 &&
      data.reporterName is string && data.reporterName.size() >= 2 && data.reporterName.size() <= 100 &&
      data.phoneNumber is string && data.phoneNumber.size() <= 25 &&
      data.category is string && data.category.size() <= 60 &&
      data.description is string && data.description.size() >= 5 &&
      data.status in ['PENDING', 'UNDER REVIEW', 'INVESTIGATING', 'ACTION TAKEN', 'RESOLVED', 'REJECTED'] &&
      data.severity in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'] &&
      data.isEmergency is bool;
    }

    match /reports/{reportId} {
      // Public read allowed for transparency & citizen tracking
      allow get: if true;
      allow list: if true;

      // Public submission allowed
      allow create: if isValidReport(request.resource.data);

      // Officer triage and status updates
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /_connection_test/{docId} {
      allow read, write: if true;
    }
  }
}
