# ==============================================================================
# EcoWatch Free Deployment Environment Configuration (₹0 Cost / Spark Plan)
# ==============================================================================

# 1. Gemini AI API Key (FREE TIER from Google AI Studio)
# Get your free key with ₹0 cost at: https://aistudio.google.com/app/apikey
# Free tier includes generous free quota without requiring a credit card or billing account.
VITE_GEMINI_API_KEY=""

# 2. Firebase Project Configuration (FREE Spark Plan)
# Obtain these from: Firebase Console (https://console.firebase.google.com/)
# -> Select Project -> Project Settings (gear icon) -> General -> "Your apps" (Web </> app)
# All parameters below run under the 100% Free Spark Quota (₹0 cost, No Credit Card needed):
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# 3. Optional Free Image Hosting (ImgBB API Key - ₹0 Cost)
# Get a free key without credit card at: https://api.imgbb.com/
# If left empty, EcoWatch automatically uses direct client-side compressed image storage
# (downscaled to <75KB), stored directly in Firestore Spark plan with zero external setup.
VITE_IMGBB_API_KEY=""

# 4. Local Node.js Development Server Secrets (Optional, only for local Express testing)
GEMINI_API_KEY=""
APP_URL=""
